<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>كشف حساب المورد</title>
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
        }

        body {
            direction: rtl;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 30px;
        }

        .invoice {
            max-width: 1400px;
            margin: auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, .08);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .company h4 {
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .company p {
            color: #777;
            margin-bottom: 4px;
        }

        .invoice-title {
            text-align: center;
        }

        .invoice-title h2 {
            color: #220946;
            margin-bottom: 10px;
        }

        .info-box {
            background: #fafafa;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #eee;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
        }

        .info-box p {
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #220946;
            color: white;
            padding: 14px;
            text-align: center;
        }

        td {
            border: 1px solid #ddd;
            padding: 3px;
            text-align: center;
        }

        tr:nth-child(even) {
            background: #fafafa;
        }

        .summary {
            width: 420px;
            margin-right: auto;
            margin-top: 30px;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            background: #fafafa;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .summary-row.total {
            font-size: 18px;
            font-weight: bold;
            color: #220946;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }

        .backbtn {
            width: 100px;
            text-align: center;
            text-decoration: none;
            background-color: #1b043b;
            color: white;
            border-radius: 8px;
            position: absolute;
            left: 20px;
            top: 20px;
            padding: 10px;
        }

        @media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice {
                box-shadow: none;
                border-radius: 0;
            }

            .backbtn {
                display: none;
            }
        }
    </style>
</head>

<body>

    <a href="/supplierPage/<%= supplier._id %>?tab=statement" class="backbtn">رجوع</a>

    <div class="invoice">

        <div class="header">
            <div class="company">
                <h4>شركة النصر (المتربيعي)</h4>
                <p>لتجارة الخضروات والفواكه</p>
            </div>

            <div class="invoice-title">
                <h2>تقرير أصناف المورد</h2>
                            <p><strong>المورد:</strong>
                <%= supplier.name %>
            </p>
            </div>

            <div>
                <p>التاريخ: <%= dayjs().format('DD/MM/YYYY') %>
                </p>
                <p>الوقت: <%= dayjs().format('hh:mm:ss') %>
                </p>
            </div>
        </div>

        <div class="info-box d-flex">

<p><strong>عدد الأصناف:</strong> <%= stats.totalProducts %></p>
<p><strong>الفترة:</strong> من <%= from || 'البداية' %> إلى <%= to || 'الآن' %></p>
        </div>

                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>الصنف</th>
                                <th>رقم الفاتورة</th>
                                <th>الوزن / العدد</th>
                                <th>تكلفة الوحدة</th>
                                <th>سعر البيع</th>
                                <th>ربح</th>
                                <th>حالة الوزن</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (products?.length> 0 ) { %>
                                <% (products || []).forEach((pr, i)=> { %>
                                    <tr style="text-align: center;" data-sale-status="<%= pr.saleStatus %>"
                                        data-invoice-type="<%= pr.invoice.invoiceType %>"
                                        data-stay-status="<%= pr.stayStatus %>">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="product-cell">
                                                <div class="product-info">
                                                    <div class="product-name">
                                                        <%= pr.productName %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.invoice.invoiceNo %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.mainWeight %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <% if (pr.invoice.invoiceType==='شراء' ) { %>
                                                <%= pr.purchaseData.wholesalePrice %> ₪
                                                    <% } %>
                                                        <% if (pr.invoice.invoiceType==='كمسيون' ) { %>
                                                            <%= pr.commissionData.commissionRate %> %
                                                                <% } %>
                                        </td>

                                        <td style="color:var(--text-muted)">
                                            <%= pr.avarageSePrice.toFixed(2) %> ₪
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.profit.toFixed(2) %> ₪
                                        </td>
                                        <td>
                                            <% if (pr.weightStatus==='متطابق' ) { %>
                                                <span class="badge-status badge-success">
                                                    <%= pr.weightStatus %>
                                                </span>
                                                <% } %>
                                                    <% if (pr.weightStatus==='نقص' ) { %>
                                                        <span class="badge-status badge-cancel">
                                                            <%= pr.weightStatus %>
                                                                <% if (pr.saleStatus==='closed' ) { %>
                                                                    - <%= pr.loseWeight %>
                                                                        <% } %>
                                                        </span>
                                                        <% } %>
                                                            <% if (pr.weightStatus==="لم يبع" ) { %>
                                                                <span class="badge-status badge-tran">
                                                                    <%= pr.weightStatus %>
                                                                </span>
                                                                <% } %>
                                        </td>

                                    </tr>
                                    <% }) %>
                                        <% } %>


                                            <% if (products.length <=0 ) { %>
                                                <tr style="text-align: center;">
                                                    <td colspan="9" style="color: #8e8c8c;">
                                                        لم يتم إضافة أي أصناف بعد
                                                    </td>
                                                </tr>
                                                <% } %>


                        </tbody>
                    </table>
                </div>
<div class="summary">
    <div class="summary-row">
        <span>إجمالي الأصناف</span>
        <span><%= stats.totalProducts %></span>
    </div>

    <div class="summary-row">
        <span>إجمالي المبيعات</span>
        <span><%= stats.totalSales.toFixed(2) %> ₪</span>
    </div>

    <div class="summary-row total">
        <span>إجمالي الأرباح</span>
        <span><%= stats.totalProfit.toFixed(2) %> ₪</span>
    </div>
</div>

    </div>
    <script src="/Libraries/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>

</html>