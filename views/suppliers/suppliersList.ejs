<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= page %>
    </title>
    <link rel="stylesheet" href="/Libraries/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .supplier-filter-panel {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.9));
            border: 1px solid rgba(129, 140, 248, 0.24);
            border-radius: 22px;
            padding: 18px 20px;
            margin-bottom: 20px;
            box-shadow: 0 12px 32px rgba(2, 6, 23, 0.28);
        }

        .supplier-filter-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }

        .supplier-search-wrap {
            min-width: 220px;
            flex: 1;
        }

        .supplier-search-wrap .input-group {
            border-radius: 16px;
            overflow: hidden;
            box-shadow: inset 0 0 0 1px rgba(129, 140, 248, 0.25);
            background: rgba(248, 250, 252, 0.05);
        }

        .supplier-search-wrap .form-control {
            border: 1px solid transparent;
            background: transparent;
            color: #f8fafc;
            padding: 12px 14px;
            font-size: 14px;
        }

        .supplier-search-wrap .form-control:focus {
            box-shadow: none;
            background: rgba(255, 255, 255, 0.04);
        }

        .supplier-search-wrap .form-control::placeholder {
            color: #cbd5e1;
        }

        .supplier-search-wrap .input-group-text {
            background: transparent;
            border: 1px solid transparent;
            color: #8b9cff;
        }

        .supplier-filter-select {
            border: 1px solid rgba(129, 140, 248, 0.24);
            border-radius: 14px;
            padding: 11px 14px;
            min-width: 200px;
            background: rgba(248, 250, 252, 0.05);
            color: #f8fafc;
        }

        .supplier-filter-select option {
            color: #0f172a;
        }

        .supplier-results-count {
            background: rgba(129, 140, 248, 0.16);
            color: #c7d2fe;
            border-radius: 999px;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 14px;
            padding: 10px 14px;
            font-weight: 600;
            transition: 0.2s ease;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
            margin-right: 5px;
        }

        .supplier-clear-btn,
        .supplier-print-btn,
        .supplier-export-btn {
            border: none;
            border-radius: 14px;
            padding: 10px 14px;
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            font-weight: 600;
            transition: 0.2s ease;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
        }

        .supplier-clear-btn:hover,
        .supplier-print-btn:hover,
        .supplier-export-btn:hover {
            transform: translateY(-1px);
        }

        .supplier-clear-btn {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
        }

        .supplier-clear-btn:hover {
            background: rgba(239, 68, 68, 0.2);
        }

        .supplier-print-btn {
            background: rgba(59, 130, 246, 0.12);
            color: #2563eb;
        }

        .supplier-print-btn:hover {
            background: rgba(59, 130, 246, 0.2);
        }

        .supplier-export-btn {
            background: rgba(16, 185, 129, 0.12);
            color: #059669;
        }

        .supplier-export-btn:hover {
            background: rgba(16, 185, 129, 0.2);
        }

        .supplier-balance-negative {
            color: #ef4444 !important;
            font-weight: 700;
        }

        .supplier-modal-content {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 65px rgba(2, 6, 23, 0.45);
            background: linear-gradient(145deg, rgba(15, 23, 42, 0.98), rgba(30, 41, 59, 0.96));
            color: #f8fafc;
        }

        .supplier-modal-header {
            background: linear-gradient(90deg, #1d4ed8 0%, #4f46e5 100%);
            color: #fff;
            border-bottom: none;
            padding: 18px 24px;
        }

        .supplier-modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

        .supplier-modal-body {
            padding: 24px;
        }

        .supplier-modal-label {
            font-weight: 700;
            color: #cbd5e1;
            margin-bottom: 8px;
        }

        .supplier-modal-input {
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 14px;
            padding: 10px 12px;
            background: rgba(248, 250, 252, 0.06);
            color: #ffffff !important;
            font-weight: 600;
        }

        .supplier-modal-input::placeholder {
            color: #94a3b8;
        }

        .supplier-modal-input:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.2);
            background: rgba(248, 250, 252, 0.08);
        }

        .supplier-modal-footer {
            border-top: none;
            padding: 0 24px 24px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .supplier-form-message {
            padding: 12px 14px;
            border-radius: 14px;
            margin-bottom: 16px;
            font-weight: 600;
            background: rgba(239, 68, 68, 0.16);
            color: #fecaca;
            border: 1px solid rgba(248, 113, 113, 0.25);
            display: none;
        }

        .supplier-form-message.success {
            background: rgba(16, 185, 129, 0.16);
            color: #bbf7d0;
            border-color: rgba(52, 211, 153, 0.25);
        }
    </style>
</head>

<body>
    <%- include('../../views/components/sidebar.ejs') %>
        <main class="main-content" style="margin-top: 20px">
            <div class="page-actions toolbar d-flex justify-content-between align-items-center">
                <h2>
                    <%= page %>
                </h2>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="#" id="printSuppliersBtn" class="supplier-print-btn"
                        style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                        <i class="fa-solid fa-print"></i>
                        طباعة
                    </a>
                    <button type="button" class="supplier-export-btn" id="exportExcelBtn">
                        <i class="fa-solid fa-file-excel"></i>
                        تصدير Excel
                    </button>
                    <button type="button" class="action-btn primary" id="openAddSupplierModalBtn">
                        <i class="fa-solid fa-circle-plus"></i>
                        إضافة مورد
                    </button>
                </div>
            </div>

            <div id="formMessages" class="formMessages" style="background-color: green;"></div>

            <div class="supplier-filter-panel">
                <div class="supplier-filter-row">
                    <div class="supplier-search-wrap">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" id="supplierSearch" class="form-control"
                                placeholder="ابحث عن اسم المورد أو الهاتف أو العنوان...">
                        </div>
                    </div>

                    <select id="governorateFilter" class="supplier-filter-select">
                        <option value="">كل المحافظات</option>
                    </select>

                    <select id="balanceFilter" class="supplier-filter-select">
                        <option value="">الأرصدة</option>
                        <option value="asc">ترتيب تصاعدي</option>
                        <option value="desc">ترتيب تنازلي</option>
                        <option value="zero">رصيد منتهي</option>
                        <option value="positive">له</option>
                        <option value="negative">عليه</option>
                    </select>

                    <div class="d-flex align-items-center g-2">
                        <button type="button" id="clearFiltersBtn" class="supplier-clear-btn">
                            <i class="fa-solid fa-broom"></i>
                        </button>
                        <div class="supplier-results-count" id="supplierResultsCount">
                            <i class="fa-solid fa-users"></i>
                            <%= suppliers?.length || 0 %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="orders-card">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم المورد</th>
                            <th>رقم الهاتف</th>
                            <th>العنوان</th>
                            <th>الرصيد</th>
                            <th>ملاحظات</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="suppliersTableBody">
                        <% if (suppliers?.length> 0) { %>
                            <% suppliers.forEach((supplier, index)=> { %>
                                <tr class="supplier-row" style="text-align: center;user-select: none;cursor: pointer;"
                                    data-governorate="<%= ((supplier.address || '').split(',')[0] || '').trim() %>"
                                    data-balance="<%= Number(supplier.balance || 0) %>"
                                    data-href="/supplierPage/<%= supplier._id %>">
                                    <td class="supplier-index" style="color:var(--blue);font-weight:600">
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <div style="font-size:13px;font-weight:600">
                                            <%= supplier.name %>
                                        </div>
                                    </td>
                                    <td style="color:var(--text-muted)">
                                        <%= supplier.phone %>
                                    </td>
                                    <td style="color:var(--text-muted)">
                                        <%= supplier.address %>
                                    </td>
                                    <td class="<%= (Number(supplier.balance || 0) < 0) ? 'supplier-balance-negative' : '' %>"
                                        style="color:var(--text-muted)">
                                        <%= (Number(supplier.balance || 0)).toFixed(2) %> ₪
                                    </td>
                                    <td style="color:var(--text-muted)">
                                        <%= supplier.notes || '-' %>
                                    </td>
                                    <td>
                                        <div class="action-btns">
                                            <button type="button" class="btn-icon btn-icon--assent supplier-edit-btn"
                                                title="تعديل المورد" data-bs-toggle="modal"
                                                data-bs-target="#supplierModal" data-id="<%= supplier._id %>"
                                                data-name="<%= supplier.name %>" data-phone="<%= supplier.phone %>"
                                                data-address="<%= supplier.address %>"
                                                data-balance="<%= Number(supplier.balance || 0) %>"
                                                data-notes="<%= supplier.notes || '' %>">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <form action="/deleteSupplier/<%= supplier._id %>" method="post"
                                                class="d-inline"
                                                onsubmit="return confirm('هل أنت متأكد من حذف هذا المورد؟')">
                                                <button class="btn-icon btn-icon--red" title="حذف المورد">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr id="emptyStateRow">
                                            <td colspan="7" style="text-align: center; color: #8e8c8c;">
                                                لا توجد موردين مسجلة حالياً
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>

        <div class="modal fade" id="supplierModal" tabindex="-1" aria-labelledby="supplierModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content supplier-modal-content">
                    <div class="modal-header supplier-modal-header">
                        <h5 class="modal-title" id="supplierModalLabel">إضافة مورد جديد</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body supplier-modal-body">
                        <div id="supplierFormMessages" class="supplier-form-message"></div>
                        <form id="supplierForm" action="/addSupplier">
                            <input type="hidden" id="supplierFormMode" value="add">
                            <input type="hidden" id="supplierId" name="supplierId" value="">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="supplier-modal-label">اسم المورد <span class="req">*</span></label>
                                    <input type="text" name="name" id="supplierName"
                                        class="form-control supplier-modal-input" placeholder="اسم المورد" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="supplier-modal-label">رقم الهاتف <span class="req">*</span></label>
                                    <input type="tel" name="phone" id="supplierPhone"
                                        class="form-control supplier-modal-input" placeholder="رقم الهاتف" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="supplier-modal-label">العنوان <span class="req">*</span></label>
                                    <input type="text" name="address" id="supplierAddress"
                                        class="form-control supplier-modal-input" placeholder="العنوان" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="supplier-modal-label">الرصيد</label>
                                    <input type="number" step="0.01" name="balance" id="supplierBalance"
                                        class="form-control supplier-modal-input" placeholder="0.00" value="0">
                                </div>
                                <div class="col-12">
                                    <label class="supplier-modal-label">ملاحظات (اختياري)</label>
                                    <textarea rows="4" name="notes" id="supplierNotes"
                                        class="form-control supplier-modal-input"
                                        placeholder="اكتب أي ملاحظات"></textarea>
                                </div>
                            </div>
                            <div class="supplier-modal-footer">
                                <button type="button" class="action-btn secondary"
                                    data-bs-dismiss="modal">إلغاء</button>
                                <button type="submit" class="action-btn primary" id="supplierSubmitBtn">حفظ</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script src="/Libraries/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/js/main.js"></script>

        <script>
            function showToast(message) {
                window.scrollTo({ left: 0, top: 0, behavior: 'smooth' });
                const messagesDiv = document.getElementById('formMessages');
                messagesDiv.innerHTML = message;
                messagesDiv.classList.add('show');
                setTimeout(() => messagesDiv.classList.remove('show'), 1500);
            }

            const supplierSearch = document.getElementById('supplierSearch');
            const governorateFilter = document.getElementById('governorateFilter');
            const balanceFilter = document.getElementById('balanceFilter');
            const supplierRows = Array.from(document.querySelectorAll('.supplier-row'));
            const emptyStateRow = document.getElementById('emptyStateRow');
            const tableBody = document.getElementById('suppliersTableBody');
            const resultsCount = document.getElementById('supplierResultsCount');
            const clearFiltersBtn = document.getElementById('clearFiltersBtn');

            supplierRows.forEach(row => {
                row.addEventListener('dblclick', () => {
                    const href = row.getAttribute('data-href');
                    if (href) {
                        window.location.href = href;
                    }
                });
            });

            function applyFilters() {
                const query = (supplierSearch?.value || '').trim().toLowerCase();
                const selectedGovernorate = (governorateFilter?.value || '').trim().toLowerCase();
                const selectedBalance = (balanceFilter?.value || '').trim().toLowerCase();

                const matchedRows = supplierRows.filter(row => {
                    const rowText = row.textContent.replace(/\s+/g, ' ').toLowerCase();
                    const rowGovernorate = (row.dataset.governorate || '').trim().toLowerCase();
                    const rowBalance = Number(row.dataset.balance || 0);
                    const matchesSearch = !query || rowText.includes(query);
                    const matchesGovernorate = !selectedGovernorate || rowGovernorate === selectedGovernorate;

                    let matchesBalance = true;

                    if (selectedBalance === 'zero') {
                        matchesBalance = rowBalance === 0;
                    } else if (selectedBalance === 'positive') {
                        matchesBalance = rowBalance > 0;
                    } else if (selectedBalance === 'negative') {
                        matchesBalance = rowBalance < 0;
                    }

                    return matchesSearch && matchesGovernorate && matchesBalance;
                });

                const sortedRows = [...matchedRows];
                if (selectedBalance === 'asc') {
                    sortedRows.sort((a, b) => Number(a.dataset.balance || 0) - Number(b.dataset.balance || 0));
                } else if (selectedBalance === 'desc') {
                    sortedRows.sort((a, b) => Number(b.dataset.balance || 0) - Number(a.dataset.balance || 0));
                }

                sortedRows.forEach((row, index) => {
                    row.style.display = '';
                    const indexCell = row.querySelector('.supplier-index');
                    if (indexCell) indexCell.textContent = index + 1;
                    tableBody.appendChild(row);
                });

                supplierRows.forEach(row => {
                    if (!sortedRows.includes(row)) {
                        row.style.display = 'none';
                    }
                });

                if (emptyStateRow) {
                    emptyStateRow.style.display = sortedRows.length > 0 ? 'none' : '';
                }

                if (resultsCount) {
                    resultsCount.textContent = ` العدد: ${sortedRows.length}`;
                }
            }

            if (supplierSearch) {
                supplierSearch.addEventListener('input', applyFilters);
            }

            if (governorateFilter) {
                const governorates = [...new Set(supplierRows.map(row => (row.dataset.governorate || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'ar'));

                governorates.forEach(governorate => {
                    const option = document.createElement('option');
                    option.value = governorate.toLowerCase();
                    option.textContent = governorate;
                    governorateFilter.appendChild(option);
                });

                governorateFilter.addEventListener('change', applyFilters);
            }

            if (balanceFilter) {
                balanceFilter.addEventListener('change', applyFilters);
            }

            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener('click', () => {
                    if (supplierSearch) supplierSearch.value = '';
                    if (governorateFilter) governorateFilter.value = '';
                    if (balanceFilter) balanceFilter.value = '';
                    applyFilters();
                });
            }

            const exportExcelBtn = document.getElementById('exportExcelBtn');
            const printSuppliersBtn = document.getElementById('printSuppliersBtn');
            const openAddSupplierModalBtn = document.getElementById('openAddSupplierModalBtn');
            const supplierModal = document.getElementById('supplierModal');
            const supplierForm = document.getElementById('supplierForm');
            const supplierFormMessages = document.getElementById('supplierFormMessages');
            const supplierFormMode = document.getElementById('supplierFormMode');
            const supplierIdInput = document.getElementById('supplierId');
            const supplierModalTitle = document.getElementById('supplierModalLabel');
            const supplierSubmitBtn = document.getElementById('supplierSubmitBtn');
            const supplierNameInput = document.getElementById('supplierName');
            const supplierPhoneInput = document.getElementById('supplierPhone');
            const supplierAddressInput = document.getElementById('supplierAddress');
            const supplierBalanceInput = document.getElementById('supplierBalance');
            const supplierNotesInput = document.getElementById('supplierNotes');

            function resetSupplierForm() {
                if (supplierForm) supplierForm.reset();
                if (supplierBalanceInput) supplierBalanceInput.value = '0';
                if (supplierFormMode) supplierFormMode.value = 'add';
                if (supplierIdInput) supplierIdInput.value = '';
                if (supplierModalTitle) supplierModalTitle.textContent = 'إضافة مورد جديد';
                if (supplierSubmitBtn) supplierSubmitBtn.textContent = 'إضافة المورد';
                if (supplierFormMessages) {
                    supplierFormMessages.style.display = 'none';
                    supplierFormMessages.innerHTML = '';
                }
            }

            if (openAddSupplierModalBtn) {
                openAddSupplierModalBtn.addEventListener('click', () => {
                    resetSupplierForm();
                    const modal = bootstrap.Modal.getOrCreateInstance(supplierModal);
                    modal.show();
                });
            }

            document.querySelectorAll('.supplier-edit-btn').forEach(button => {
                button.addEventListener('click', () => {
                    resetSupplierForm();
                    const modal = bootstrap.Modal.getOrCreateInstance(supplierModal);
                    if (supplierFormMode) supplierFormMode.value = 'edit';
                    if (supplierIdInput) supplierIdInput.value = button.dataset.id || '';
                    if (supplierModalTitle) supplierModalTitle.textContent = 'تعديل بيانات المورد';
                    if (supplierSubmitBtn) supplierSubmitBtn.textContent = 'حفظ التعديلات';
                    if (supplierForm) supplierForm.action = `/updateSupplier/${button.dataset.id || ''}`;
                    if (supplierNameInput) supplierNameInput.value = button.dataset.name || '';
                    if (supplierPhoneInput) supplierPhoneInput.value = button.dataset.phone || '';
                    if (supplierAddressInput) supplierAddressInput.value = button.dataset.address || '';
                    if (supplierBalanceInput) supplierBalanceInput.value = button.dataset.balance || '0';
                    if (supplierNotesInput) supplierNotesInput.value = button.dataset.notes || '';
                    modal.show();
                });
            });

            if (supplierForm) {
                supplierForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    if (supplierFormMessages) {
                        supplierFormMessages.classList.remove('success');
                        supplierFormMessages.innerHTML = '';
                    }

                    const formData = new FormData(supplierForm);
                    const payload = {};
                    formData.forEach((value, key) => payload[key] = value);

                    try {
                        const response = await fetch(supplierForm.action, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json',
                            },
                            body: JSON.stringify(payload),
                        });

                        const data = await response.json();

                        if (!data.success) {
                            if (supplierFormMessages) {
                                supplierFormMessages.innerHTML = data.message || 'حدث خطأ';
                                supplierFormMessages.classList.remove('success');
                                supplierFormMessages.style.display = 'block';
                            }
                            return;
                        }

                        if (data.redirect) {
                            supplierFormMessages.classList.add('success');
                            supplierFormMessages.innerHTML = data.message || 'تم الحفظ بنجاح';
                            supplierFormMessages.style.display = 'block';
                            setTimeout(() => {
                                window.location.href = data.redirect;
                            }, 900);
                        }
                    } catch (error) {
                        console.error(error);
                        if (supplierFormMessages) {
                            supplierFormMessages.innerHTML = 'حدث خطأ في حفظ البيانات';
                            supplierFormMessages.classList.remove('success');
                            supplierFormMessages.style.display = 'block';
                        }
                    }
                });
            }

            if (exportExcelBtn) {
                exportExcelBtn.addEventListener('click', () => {
                    const query = (supplierSearch?.value || '').trim();
                    const governorate = (governorateFilter?.value || '').trim();
                    const balance = (balanceFilter?.value || '').trim();

                    const params = new URLSearchParams();
                    if (query) params.set('search', query);
                    if (governorate) params.set('governorate', governorate);
                    if (balance) params.set('balance', balance);

                    window.location.href = `/exportSuppliersExcel?${params.toString()}`;
                });
            }

            if (printSuppliersBtn) {
                printSuppliersBtn.addEventListener('click', (event) => {
                    event.preventDefault();
                    const query = (supplierSearch?.value || '').trim();
                    const governorate = (governorateFilter?.value || '').trim();
                    const balance = (balanceFilter?.value || '').trim();

                    const params = new URLSearchParams();
                    if (query) params.set('search', query);
                    if (governorate) params.set('governorate', governorate);
                    if (balance) params.set('balance', balance);

                    window.location.href = `/printSuppliersList?${params.toString()}`;
                });
            }

            // Handle delete requests
            document.querySelectorAll('form[action*="/deleteSupplier/"]').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                        });

                        const result = await response.json();

                        if (result.success) {
                            showToast(result.message);
                            setTimeout(() => {
                                window.location.href = result.redirect;
                            }, 1000);
                        } else {
                            showToast(result.message);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showToast('حدث خطأ في الحذف');
                    }
                });
            });
        </script>

        <% if (msg) { %>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    showToast("<%= msg %>");
                });
            </script>
            <% } %>
</body>

</html>