<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>طباعة قائمة الموردين</title>
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; }
        body {
            direction: rtl;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 30px;
        }
        .invoice {
            max-width: 1400px;
            margin: auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, .08);
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .company h4 { color: #2c3e50; margin-bottom: 8px; }
        .company p { color: #777; margin-bottom: 4px; }
        .invoice-title { text-align: center; }
        .invoice-title h2 { color: #220946; margin-bottom: 10px; }
        .info-box {
            background: #fafafa;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #eee;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
        }
        table { width: 100%; border-collapse: collapse; }
        th {
            background: #220946;
            color: white;
            padding: 12px;
            text-align: center;
        }
        td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }
        tr:nth-child(even) { background: #fafafa; }
        .backbtn {
            width: 100px;
            text-align: center;
            text-decoration: none;
            background-color: #1b043b;
            color: white;
            border-radius: 8px;
            position: absolute;
            left: 20px;
            top: 20px;
            padding: 10px;
        }
        @media print {
            body { background: white; padding: 0; }
            .invoice { box-shadow: none; border-radius: 0; }
            .backbtn { display: none; }
        }
    </style>
</head>

<body>
    <a href="/suppliersList" class="backbtn">رجوع</a>

    <div class="invoice">
        <div class="header">
            <div class="company">
                <h4>شركة النصر (المتربيعي)</h4>
                <p>لتجارة الخضروات والفواكه</p>
            </div>

            <div class="invoice-title">
                <h2>قائمة الموردين</h2>
                <p><strong>عدد الموردين:</strong> <%= suppliers.length %></p>
            </div>

            <div>
                <p>التاريخ: <%= printDate %></p>
                <p>الوقت: <%= printTime %></p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم المورد</th>
                    <th>رقم الهاتف</th>
                    <th>العنوان</th>
                    <th>الرصيد</th>
                    <th>ملاحظات</th>
                </tr>
            </thead>
            <tbody>
                <% if (suppliers && suppliers.length > 0) { %>
                    <% suppliers.forEach((supplier, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= supplier.name %></td>
                            <td><%= supplier.phone %></td>
                            <td><%= supplier.address %></td>
                            <td><%= Number(supplier.balance || 0).toFixed(2) %> ₪</td>
                            <td><%= supplier.notes || '-' %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6">لا توجد بيانات</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script>
        window.onload = () => window.print();
    </script>
</body>
</html>
