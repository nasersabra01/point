<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>كشف حساب المورد</title>
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
        }

        body {
            direction: rtl;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 30px;
        }

        .invoice {
            max-width: 1400px;
            margin: auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0, 0, 0, .08);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .company h4 {
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .company p {
            color: #777;
            margin-bottom: 4px;
        }

        .invoice-title {
            text-align: center;
        }

        .invoice-title h2 {
            color: #220946;
            margin-bottom: 10px;
        }

        .info-box {
            background: #fafafa;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #eee;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
        }

        .info-box p {
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #220946;
            color: white;
            padding: 14px;
            text-align: center;
        }

        td {
            border: 1px solid #ddd;
            padding: 3px;
            text-align: center;
        }

        tr:nth-child(even) {
            background: #fafafa;
        }

        .summary {
            width: 420px;
            margin-right: auto;
            margin-top: 30px;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            background: #fafafa;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .summary-row.total {
            font-size: 18px;
            font-weight: bold;
            color: #220946;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }

        .backbtn {
            width: 100px;
            text-align: center;
            text-decoration: none;
            background-color: #1b043b;
            color: white;
            border-radius: 8px;
            position: absolute;
            left: 20px;
            top: 20px;
            padding: 10px;
        }

        @media print {
            body {
                background: white;
                padding: 0;
            }

            .invoice {
                box-shadow: none;
                border-radius: 0;
            }

            .backbtn {
                display: none;
            }
        }
    </style>
</head>

<body>

    <a href="/supplierPage/<%= supplier._id %>?tab=statement" class="backbtn">رجوع</a>

    <div class="invoice">

        <div class="header">
            <div class="company">
                <h4>شركة النصر (المتربيعي)</h4>
                <p>لتجارة الخضروات والفواكه</p>
            </div>

            <div class="invoice-title">
                <h2>كشف مدفوعات المورد</h2>
                <p><strong>المورد:</strong>
                    <%= supplier.name %>
                </p>
            </div>

            <div>
                <p>التاريخ: <%= dayjs().format('DD/MM/YYYY') %>
                </p>
                <p>الوقت: <%= dayjs().format('hh:mm:ss') %>
                </p>
            </div>
        </div>

        <div class="info-box d-flex">

            <p><strong>عدد الدفعات:</strong>
                <%= payments.length %>
            </p>
            <p><strong>الفترة:</strong> من <%= from || 'البداية' %> إلى <%= to || 'الآن' %>
            </p>
        </div>

        <div class="orders-card">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>التاريخ</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>من</th>
                        <th>إلى</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (payments.length> 0) { %>
                        <% payments.forEach((payment, i)=> { %>
                            <tr style="text-align: center;" class="payment-row"
                                data-payment="<%= payment.paymentMethod %>"
                                data-supplier="<%= payment.supplier?.name || '' %>">

                                <td>
                                    <%= i + 1 %>
                                </td>

                                <td>
                                    <%= dayjs(payment.createdAt).format('DD/MM/YYYY') %>
                                </td>


                                <td style="color: var(--green); font-weight:700;">
                                    <%= payment.amount.toFixed(2) %> ₪
                                </td>

                                <td>
                                    <% if (payment.paymentMethod==='cash' ) { %>
                                        <span class="badge-status badge-success">كاش</span>
                                        <% } else if(payment.paymentMethod==='bank_transfer' ) { %>
                                            <span class="badge-status badge-tran">تحويل بنكي</span>
                                            <% } else if(payment.paymentMethod==='trans' ) { %>
                                                <span class="badge-status badge-tran">تكاليف نقل</span>
                                                <% } else if(payment.paymentMethod==='other' ) { %>
                                                    <span class="badge-status badge-tran">أخرى</span>
                                                    <% } else if(payment.paymentMethod==='staf' ) { %>
                                                        <span class="badge-status badge-tran">بضاعة</span>
                                                        <% } %>
                                </td>


                                <td>
                                    <%= payment.senderAccountName || '-' %>
                                </td>
                                <td>
                                    <%= payment.receiverAccountName || '-' %>
                                </td>
                                <td>
                                    <%= payment.notes || '-' %>
                                </td>

                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9" style="text-align:center;color:#94A3B8;">
                                            لا توجد مدفوعات حتى الآن
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="summary">

            <div class="summary-row">
                <span>إجمالي الكاش</span>
                <span>
                    <%= stats.totalCash.toFixed(2) %> ₪
                </span>
            </div>

            <div class="summary-row">
                <span>إجمالي التحويل البنكي</span>
                <span>
                    <%= stats.totalBank.toFixed(2) %> ₪
                </span>
            </div>

            <div class="summary-row total">
                <span>إجمالي المدفوعات</span>
                <span>
                    <%= stats.totalPayments.toFixed(2) %> ₪
                </span>
            </div>

        </div>

    </div>
    <script src="/Libraries/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>

</html>