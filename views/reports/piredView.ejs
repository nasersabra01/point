<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= page %> - <%= dayjs(from).format('dddd') %> <%= from %> إلى <%= dayjs(to).format('dddd') %> <%= to %>
    </title>

    <!-- Google Fonts -->
    <link rel="stylesheet" href="/Libraries/fontawesome/css/all.min.css"> <!-- fontawesome css file -->
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css"> <!-- bootstrap css min file -->

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .modern-tabs {
            display: flex;
            width: fit-content;
            justify-content: space-between;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .modern-tabs button {
            margin: 0 2px;
        }



        .tab-btn {
            border: none;
            background: rgba(20, 30, 60, .75);
            color: #b6c2d9;
            padding: 12px 6px;
            border-radius: 14px;
            transition: .3s;
        }

        .tab-btn.active {
            background: linear-gradient(90deg, #5B5CFF, #7A5FFF);
            color: white;
        }

        .tab-section {
            display: none;
        }

        .tab-section.active {
            display: block;
        }


        .orders-card {
            border-radius: 22px;
            overflow: hidden;
        }

        .orders-table tbody tr {
            transition: .25s;
        }

        .orders-table tbody tr:hover {
            background: rgba(91, 92, 255, .08);
        }

        .orders-table td {
            vertical-align: middle;
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .product-info {
            width: 100%;
        }

        .product-name {
            color: white;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .overview-card {
            padding: 25px;
            border-radius: 20px;
            color: white;
        }

        .sales-card {
            background: linear-gradient(135deg, #2564eb00, #1d4fd83f);
        }

        .profit-card {
            background: linear-gradient(135deg, #16a34a00, #15803c40);
        }

        .expense-card {
            background: linear-gradient(135deg, #dc262600, #b91c1c3f);
        }

        .net-card {
            background: linear-gradient(135deg, #7c3aed00, #5a21b642);
        }

        .overview-card span {
            display: block;
            margin-bottom: 12px;
            opacity: .9;
        }

        .overview-card strong {
            font-size: 26px;
        }

        .overview-stats {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .mini-stat {
            background: rgba(20, 30, 60, .65);
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 16px;
            padding: 18px;
            text-align: center;
        }

        .mini-stat span {
            display: block;
            color: #94a3b8;
            margin-bottom: 8px;
        }

        .mini-stat strong {
            color: white;
            font-size: 22px;
        }

        .overview-summary {
            background: rgba(20, 30, 60, .65);
            border-radius: 20px;
            padding: 25px;
        }

        .product-supplier {
            color: #8da2c0;
            font-size: 12px;
            margin-bottom: 8px;

        }
    </style>

</head>



<body>
    <!-- sidebar -->
    <%- include('../components/sidebar.ejs') %>

        <main class="main-content" style="margin-top: 20px">

            <div class="page-actions toolbar">
                <div>
                    <%= page %> من --- ( <%= dayjs(from).format('dddd') %>
                            <%= from %> ) إلى --- ( <%= dayjs(to).format('dddd') %>
                                    <%= to %> )


                </div>


                <div class="d-flex justify-content-end">
                    <% if (shifts && shifts.length>0) { %>
                        <a href="/dayReport/<%= shifts[0]._id %>" class="action-btn secondary">
                            <i class="fa-solid fa-print"></i>
                            طباعة تقرير اليوم
                        </a>
                    <% } %>
                </div>
            </div>

            <div id="formMessages" class="formMessages" style="background-color: green;">
            </div>

            <div class="modern-tabs">
                <button class="tab-btn active" data-filter="invoices">الفواتير <%= invoices.length %></button>
                <button class="tab-btn" data-filter="purchaseInvoicesss">فواتير شراء <%= purchaseInvoicesss.length %>
                </button>
                <button class="tab-btn" data-filter="commissionInvoicesss">فواتير كمسيون <%= commissionInvoicesss.length
                        %></button>
                <button class="tab-btn" data-filter="all">الكشوفات <%= products.length %></button>
                <button class="tab-btn" data-filter="delayed">كشوفات اجلة <%= report.delayedProducts %></button>
                <button class="tab-btn" data-filter="loseWeightProducts">نقص <%= loseWeightProducts.length %></button>
                <button class="tab-btn" data-filter="payments">دفعات <%= payments.length %></button>
                <button class="tab-btn" data-filter="expenses">مصاريف <%= report.totalExpenses.toFixed(2) %>
                </button>
                </button>
                <button class="tab-btn" data-filter="overview">نظرة عامة</button>
            </div>

            <div class="tab-section active" id="invoices-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الفاتورة</th>
                                <th>عدد الأصناف</th>
                                <th>اسم المورد</th>
                                <th>إجمالي الفاتورة</th>
                                <th>ربح الفاتورة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (invoices.length> 0 ) { %>
                                <% (invoices).forEach((sale, i)=> { %>
                                    <tr style="text-align: center;">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div>
                                                    <div style="font-size:13px;font-weight:600">
                                                        <%= sale.invoiceNo %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.productsCount %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.supplier.name %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.total.toFixed(2) %>
                                        </td>
                                        <td>
                                            <%= sale.totalProfit.toFixed(2) %> ₪
                                        </td>
                                        <td>
                                            <div class="action-btns">
                                                <a href="/invoiceDetailes/<%= sale._id %>" class="btn-icon"
                                                    title="عرض تفاصيل الفاتورة">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } %>

                                            <% if (invoices.length <=0 ) { %>
                                                <tr>
                                                    <td colspan="6" style="color: #8e8c8c;">
                                                        لم يتم إضافة أي فاتورة بعد.
                                                    </td>
                                                </tr>

                                                <% } %>

                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="purchaseInvoicesss-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الفاتورة</th>
                                <th>عدد الأصناف</th>
                                <th>اسم المورد</th>
                                <th>إجمالي الفاتورة</th>
                                <th>ربح الفاتورة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (purchaseInvoicesss.length> 0 ) { %>
                                <% (purchaseInvoicesss).forEach((sale, i)=> { %>
                                    <tr style="text-align: center;">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div>
                                                    <div style="font-size:13px;font-weight:600">
                                                        <%= sale.invoiceNo %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.productsCount %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.supplier.name %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.total.toFixed(2) %> ₪
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.totalProfit.toFixed(2) %> ₪
                                        </td>
                                        <td>
                                            <div class="action-btns">
                                                <a href="/invoiceDetailes/<%= sale._id %>" class="btn-icon"
                                                    title="عرض تفاصيل الفاتورة">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } %>

                                            <% if (purchaseInvoicesss.length <=0 ) { %>
                                                <tr>
                                                    <td colspan="6" style="color: #8e8c8c;">
                                                        لم يتم إضافة أي فاتورة بعد.
                                                    </td>
                                                </tr>

                                                <% } %>

                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="commissionInvoicesss-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الفاتورة</th>
                                <th>عدد الأصناف</th>
                                <th>اسم المورد</th>
                                <th>إجمالي الفاتورة</th>
                                <th>ربح الفاتورة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (commissionInvoicesss.length> 0 ) { %>
                                <% (commissionInvoicesss).forEach((sale, i)=> { %>
                                    <tr style="text-align: center;">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div>
                                                    <div style="font-size:13px;font-weight:600">
                                                        <%= sale.invoiceNo %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.productsCount %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.supplier.name %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= sale.total.toFixed(2) %>
                                        </td>
                                        <td>
                                            <%= sale.totalProfit.toFixed(2) %> ₪
                                        </td>
                                        <td>
                                            <div class="action-btns">
                                                <a href="/invoiceDetailes/<%= sale._id %>" class="btn-icon"
                                                    title="عرض تفاصيل الفاتورة">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } %>

                                            <% if (commissionInvoicesss.length <=0 ) { %>
                                                <tr>
                                                    <td colspan="6" style="color: #8e8c8c;">
                                                        لم يتم إضافة أي فاتورة بعد.
                                                    </td>
                                                </tr>

                                                <% } %>

                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="products-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>الصنف</th>
                                <th>الوزن / العدد</th>
                                <th>تكلفة الوحدة</th>
                                <th>رقم الفاتورة</th>
                                <th>ربح</th>
                                <th>حالة الوزن</th>
                                <th>حالة البيع</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (products?.length> 0 ) { %>
                                <% (products || []).forEach((pr, i)=> { %>
                                    <tr style="text-align: center;" data-sale-status="<%= pr.saleStatus %>"
                                        data-invoice-type="<%= pr.invoice.invoiceType %>"
                                        data-stay-status="<%= pr.stayStatus %>">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="product-cell">
                                                <div class="product-info">
                                                    <div class="product-name">
                                                        <%= pr.productName %>
                                                    </div>

                                                    <div class="product-supplier">
                                                        <%= pr.invoice?.supplier?.name || 'بدون مورد' %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.mainWeight %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <% if (pr.invoice.invoiceType==='شراء' ) { %>
                                                <%= pr.purchaseData.wholesalePrice %> ₪
                                                    <% } %>
                                                        <% if (pr.invoice.invoiceType==='كمسيون' ) { %>
                                                            <%= pr.commissionData.commissionRate %> %
                                                                <% } %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.invoice.invoiceNo %>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.profit.toFixed(2) %> ₪
                                        </td>
                                        <td>
                                            <% if (pr.weightStatus==='متطابق' ) { %>
                                                <span class="badge-status badge-success">
                                                    <%= pr.weightStatus %>
                                                </span>
                                                <% } %>
                                                    <% if (pr.weightStatus==='نقص' ) { %>
                                                        <span class="badge-status badge-cancel">
                                                            <%= pr.weightStatus %>
                                                                <% if (pr.saleStatus==='closed' ) { %>
                                                                    - <%= pr.loseWeight %>
                                                                        <% } %>
                                                        </span>
                                                        <% } %>
                                                            <% if (pr.weightStatus==="لم يبع" ) { %>
                                                                <span class="badge-status badge-tran">
                                                                    <%= pr.weightStatus %>
                                                                </span>
                                                                <% } %>
                                        </td>
                                        <td>
                                            <% if (pr.saleStatus==='open' ) { %>
                                                <% if (pr.stayStatus==='ontherDay' ) { %>
                                                    <span class="badge-status badge-success">
                                                        مفتوح - آجل
                                                    </span>
                                                    <% } %>
                                                        <% if (pr.stayStatus==='today' ) { %>
                                                            <span class="badge-status badge-success">
                                                                مفتوح
                                                            </span>
                                                            <% } %>
                                                                <% } %>
                                                                    <% if (pr.saleStatus==='closed' ) { %>
                                                                        <span class="badge-status badge-cancel">
                                                                            مغلق
                                                                        </span>
                                                                        <% } %>
                                        </td>
                                        <td>
                                            <div class="action-btns">
                                                <a href="/productSaleStatment/<%=  pr._id %>"
                                                    class="btn-icon btn-icon--green" title="إنشاء كشف بيع">
                                                    <i class="fa-solid fa-clipboard-list"></i>
                                                </a>
                                                <a href="/invoiceDetailes/<%=  pr.invoice._id %>"
                                                    class="btn-icon btn-icon--assent" title="عرض داخل الفاتورة">
                                                    <i class="fa-solid fa-arrows-to-eye"></i>
                                                </a>
                                                <a href="/productDetailsPage/<%=  pr._id %>" class="btn-icon"
                                                    title="عرض تفاصيل الصنف">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>

                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>


                                            <% if (products.length <=0 ) { %>
                                                <tr style="text-align: center;">
                                                    <td colspan="9" style="color: #8e8c8c;">
                                                        لم يتم إضافة أي أصناف بعد
                                                    </td>
                                                </tr>
                                                <% } %>


                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="payments-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>التاريخ</th>
                                <th>المورد</th>
                                <th>المبلغ</th>
                                <th>طريقة الدفع</th>
                                <th>من</th>
                                <th>إلى</th>
                                <th>ملاحظات</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (payments.length> 0) { %>
                                <% payments.forEach((payment, i)=> { %>
                                    <tr style="text-align: center;" class="payment-row"
                                        data-payment="<%= payment.paymentMethod %>"
                                        data-supplier="<%= payment.supplier?.name || '' %>">

                                        <td>
                                            <%= i + 1 %>
                                        </td>

                                        <td>
                                            <%= dayjs(payment.createdAt).format('YYYY-MM-DD') %>
                                        </td>

                                        <td>
                                            <%= payment.supplier?.name || '-' %>
                                        </td>

                                        <td style="color: var(--green); font-weight:700;">
                                            <%= payment.amount.toFixed(2) %> ₪
                                        </td>

                                        <td>
                                            <% if (payment.paymentMethod==='cash' ) { %>
                                                <span class="badge-status badge-success">كاش</span>
                                                <% } else if(payment.paymentMethod==='bank_transfer' ) { %>
                                                    <span class="badge-status badge-tran">تحويل بنكي</span>
                                                    <% } else if(payment.paymentMethod==='trans' ) { %>
                                                        <span class="badge-status badge-tran">تكاليف نقل</span>
                                                        <% } else if(payment.paymentMethod==='other' ) { %>
                                                            <span class="badge-status badge-tran">أخرى</span>
                                                            <% } else if(payment.paymentMethod==='staf' ) { %>
                                                                <span class="badge-status badge-tran">بضاعة</span>
                                                                <% } %>
                                        </td>


                                        <td>
                                            <%= payment.senderAccountName || '-' %>
                                        </td>
                                        <td>
                                            <%= payment.receiverAccountName || '-' %>
                                        </td>
                                        <td>
                                            <%= payment.notes || '-' %>
                                        </td>

                                        <td>
                                            <% if (payment.day.status==='open' ) { %>
                                                <div class="action-btns">
                                                    <a href="/editPaymentPage/<%= payment._id %>"
                                                        class="btn-icon btn-icon--assent">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </a>
                                                    <form action="/deletePayment/<%= payment._id %>" method="POST"
                                                        class="delete-payment-form">
                                                        <button type="submit" class="btn-icon btn-icon--red">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                                <% } else {%>
                                                    ---
                                                    <% } %>
                                        </td>

                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="9" style="text-align:center;color:#94A3B8;">
                                                    لا توجد مدفوعات حتى الآن
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="expenses-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>نوع المصروف</th>
                                <th>المجموع</th>
                                <th>عدد السجلات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (groupedExpenses?.length> 0 ) { %>
                                <% (groupedExpenses || []).forEach((item, i)=> { %>
                                    <tr style="text-align: center;">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div>
                                                    <div style="font-size:13px;font-weight:600">
                                                        <%= item.expType %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= item.totalAmount.toFixed(2) %> ₪
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= item.count %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <tr>
                                            <th style="text-align: center;">#</th>
                                            <th style="color: rgb(232, 45, 45);">الإجمالي</th>
                                            <th style="text-align: center;color: rgb(232, 45, 45);">
                                                <%= report.totalExpenses.toFixed(2) %> ₪
                                            </th>
                                            <th style="text-align: center;color: rgb(232, 45, 45);">
                                                <%= expenses.length %>
                                            </th>
                                        </tr>
                                        <% } else { %>
                                            <tr style="text-align: center;">
                                                <td colspan="4" style="color: #8e8c8c;">
                                                    لم يتم صرف اي شي خلال هذه الفترة
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-section" id="loseWeightProducts-section">
                <div class="orders-card">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>الصنف</th>
                                <th>المورد</th>
                                <th>الكمية الاصلية</th>
                                <th>الكمية المباعة</th>
                                <th>كمية النقص</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (loseWeightProducts?.length> 0 ) { %>
                                <% (loseWeightProducts || []).forEach((pr, i)=> { %>
                                    <tr style="text-align: center;">
                                        <td style="color:var(--blue);font-weight:600">
                                            <%= i + 1 %>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="order-avatar"
                                                    style="background:linear-gradient(135deg,#3B82F6,#8B5CF6)">
                                                    <%= pr.productName.charAt(0) %>
                                                </div>
                                                <div>
                                                    <div style="font-size:13px;font-weight:600">
                                                        <%= pr.productName %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td style="color:var(--text-muted)">
