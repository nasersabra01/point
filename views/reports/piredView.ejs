        <script>
            function showToast() {
                const t = document.getElementById('formMessages');
                if (!t) return;

                window.scrollTo({ left: 0, top: 0, behavior: 'smooth' });
                t.classList.add('show');

                setTimeout(() => t.classList.remove('show'), 3000);
            }
        </script>

        <% if (msg) { %>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const messagesDiv = document.getElementById('formMessages');
                    messagesDiv.innerHTML = "<%= msg %>";
                    showToast();
                });
            </script>
            <% } %>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const tabs = document.querySelectorAll('.tab-btn');
                        const sections = document.querySelectorAll('.tab-section');
                        const productRows = document.querySelectorAll('#products-section tbody tr[data-sale-status]');

                        function showSection(sectionId) {
                            sections.forEach(s => s.classList.remove('active'));
                            document.getElementById(sectionId).classList.add('active');
                        }

                        function filterProducts(filter) {
                            showSection('products-section');

                            productRows.forEach(row => {
                                const saleStatus = row.dataset.saleStatus;
                                const stayStatus = row.dataset.stayStatus;

                                let show = false;

                                if (filter === 'all') show = true;
                                if (filter === 'open' && saleStatus === 'open' && stayStatus === 'today') show = true;
                                if (filter === 'closed' && saleStatus === 'closed') show = true;
                                if (filter === 'delayed' && stayStatus === 'ontherDay') show = true;

                                row.style.display = show ? '' : 'none';
                            });
                        }

                        tabs.forEach(tab => {
                            tab.addEventListener('click', () => {
                                tabs.forEach(t => t.classList.remove('active'));
                                tab.classList.add('active');

                                const filter = tab.dataset.filter;

                                if (filter === 'all') {
                                    filterProducts('all');
                                }

                                else if (filter === 'open') {
                                    filterProducts('open');
                                }

                                else if (filter === 'closed') {
                                    filterProducts('closed');
                                }

                                else if (filter === 'delayed') {
                                    filterProducts('delayed');
                                }

                                else if (filter === 'invoices') {
                                    showSection('invoices-section');
                                }

                                else if (filter === 'purchaseInvoicesss') {
                                    showSection('purchaseInvoicesss-section');
                                }

                                else if (filter === 'commissionInvoicesss') {
                                    showSection('commissionInvoicesss-section');
                                }

                                else if (filter === 'expenses') {
                                    showSection('expenses-section');
                                }

                                else if (filter === 'overview') {
                                    showSection('overview-section');
                                }

                                else if (filter === 'payments') {
                                    showSection('payments-section');
                                }
                                else if (filter === 'loseWeightProducts') {
                                    showSection('loseWeightProducts-section');
                                }
                            });
                        });
                    });



                </script>
                <script>
                    async function deleteInvoice(id, force = false) {
                        try {
                            if (!force) {
                                const firstConfirm = confirm('هل تريد حذف الفاتورة؟');
                                if (!firstConfirm) return;
                            }

                            const url = force
                                ? `/deleteInvoice/${id}?force=true`
                                : `/deleteInvoice/${id}`;

                            const res = await fetch(url, {
                                method: 'POST'
                            });

                            const data = await res.json();

                            if (data.success) {
                                alert(data.msg);
                                location.reload();
                                return;
                            }

                            if (data.needsConfirmation) {
                                const secondConfirm = confirm(data.msg);

                                if (secondConfirm) {
                                    await deleteInvoice(id, true);
                                }

                                return;
                            }

                            alert(data.msg);

                        } catch (error) {
                            console.error(error);
                            alert('حدث خطأ أثناء حذف الفاتورة');
                        }
                    }
                </script>
</body>

</html>