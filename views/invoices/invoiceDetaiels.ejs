<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تفاصيل الفاتورة</title>

    <link rel="stylesheet" href="/Libraries/fontawesome/css/all.min.css"> <!-- fontawesome css file -->
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css"> <!-- bootstrap css min file -->

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/css/main.css">

    <style>
        .invoice-wrapper {
            padding: 30px 0;
        }

        .btn-icon {
            border: none;
            width: 15px;
            height: 15px;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .invoice-title span {
            color: var(--text-muted);
        }

        .invoice-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 24px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
        }

        .info-box {
            text-align: center;
        }

        .info-label {
            color: var(--text-muted);
            font-size: 13px;
            margin-bottom: 12px;
        }

        .info-value {
            font-size: 18px;
            font-weight: 700;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .summary-box {
            width: 500px;
            margin-right: auto;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px 70px;
        }

        .notes-box {
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 14px 16px;
            height: 260px;
        }

        .notes-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--text-muted);
        }

        .notes-content {
            font-size: 15px;
            line-height: 1.7;
            white-space: pre-wrap;
        }

        .sum-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 14px;
            font-size: 18px;
        }

        .sum-row.total {
            color: var(--purple);
            font-size: 24px;
            font-weight: 800;
            margin-top: 20px;
        }

        .actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-top: 30px;
        }

        .btn-full {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 14px;
            font-weight: 700;
            cursor: pointer;
            font-size: 16px;
        }

        .btn-edit {
            background: transparent;
            border: 1px solid var(--purple);
            color: var(--purple);
        }

        .btn-print {
            background: transparent;
            border: 1px solid var(--border);
            color: white;
        }

        .btn-pdf {
            background: transparent;
            border: 1px solid var(--border);
            color: white;
        }

        .btn-back {
            background: rgba(16, 185, 129, .15);
            color: var(--green);
            border: 1px solid rgba(16, 185, 129, .3);
        }

        .stats-grid {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-card {
            width: 48%;
        }
    </style>
</head>

<body>

    <!-- sidebar -->
    <%- include('../../views/components/sidebar.ejs') %>
        <main class="main-content">

            <!-- <div class="invoice-wrapper"> -->
            <div class="page-actions toolbar">
                <div style="display: flex;justify-content: space-between;align-items: center;width: 100%;">
                    <div class="invoice-title d-flex align-items-center justify-content-between" style="width: 380px;">
                        <h3>تفاصيل فاتورة <%= invoice.invoiceType %>
                        </h3>
                        <h6>- <%= invoice.invoiceNo %>
                        </h6>
                    </div>
                    <div class="d-flex <%= invoice.day.status === 'open'? 'justify-content-between' : 'justify-content-end' %> "
                        style="width: 400px;">
                        <a href="/createProductPage/<%= invoice._id %>" class="action-btn primary">
                            <i class="fa-solid fa-circle-plus"></i> إضافة صنف
                        </a>
                        <a href="/print/<%= invoice._id %>" class="action-btn secondary">
                            <i class="fa-solid fa-print"></i> طباعة A4
                        </a>
                        <a href="/printA5/<%= invoice._id %>" class="action-btn primary">
                            <i class="fa-solid fa-print"></i> طباعة A5
                        </a>

                    </div>

                </div>
            </div>


            <div class="stats-grid">
                <div class="stat-card purple" style="display: flex;align-items: center;">
                    <div class="stat-label" style="margin-left: 20px;">تاريخ الإنشاء :</div>
                    <div class="">
                        <%= dayjs(invoice.day.startTime).format('dddd') %> -
                            <%= dayjs(invoice.day.startTime).format('DD/MM/YYYY') %>
                    </div>
                </div>
                <!-- <div class="stat-card purple">
                    <div class="stat-label">عدد الأصناف</div>
                    <div class="stat-value">
                        <%= products?.length %>
                    </div>
                </div> -->



                <div class="stat-card green" style="display: flex;">
                    <div class="stat-label" style="margin-left: 20px;">المورد :</div>
                    <div class="stat-value">
                        <%= invoice.supplier.name %>
                            
                    </div>
                </div>
                <div class="stat-card green" style="display: flex;">
                    <div class="stat-label" style="margin-left: 20px;">ربح الفاتورة :</div>
                    <div class="stat-value">
                        <%= totalProfit.toFixed(2) %> ₪
                    </div>
                </div>


            </div>

            <div class="orders-card">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الصنف</th>
                            <th>الوزن / العدد</th>
                            <% if (invoice.invoiceType==='شراء' ) { %>
                                <th>تكلفة الوحدة</th>
                                <th>مجموع</th>
                                <% } %>
                                    <% if (invoice.invoiceType==='كمسيون' ) { %>
                                        <th>مبيعات</th>
                                        <th>نسبة العمولة</th>
                                        <th>مستحق العمولة</th>
                                        <th>مستحق المورد</th>
                                        <% } %>

                                            <th>متوسط سعر البيع</th>
                                            <th>حالة الوزن</th>
                                            <th>حالة البيع</th>
                                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (products?.length> 0 ) { %>
                            <% (products || []).forEach((pr, i)=> { %>
                                <tr class="produ-row" style="text-align: center;user-select: none;cursor: pointer;"
                                    style="text-align:center;" data-href="/productSaleStatment/<%= pr._id %>">
                                    <td style="color:var(--blue);font-weight:600">
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center align-items-center">

                                            <div>
                                                <div style="font-size:13px;font-weight:600">
                                                    <%= pr.productName %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="color:var(--text-muted)">
                                        <%= pr.mainWeight.toFixed(2) %>
                                            <%= pr.unit %>
                                    </td>

                                    <% if (pr.invoice.invoiceType==='شراء' ) { %>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.purchaseData.wholesalePrice.toFixed(2) %> ₪
                                        </td>
                                        <td style="color:var(--text-muted)">
                                            <%= pr.purchaseData.totalCost.toFixed(2) %> ₪
                                        </td>
                                        <% } %>






                                            <% if (pr.invoice.invoiceType==='كمسيون' ) { %>
                                                <td style="color:var(--text-muted)">
                                                    <%= pr.sales.toFixed(2) %> ₪
                                                </td>
                                                <td style="color:var(--text-muted)">
                                                    <%= pr.commissionData.commissionRate %> %
                                                </td>

                                                <td style="color:var(--text-muted)">
                                                    <%= pr.commissionData.commissionAmount.toFixed(2) %> ₪
                                                </td>
                                                <td style="color:var(--text-muted)">
                                                    <%= pr.commissionData.supplierAmount.toFixed(2) %> ₪
                                                </td>
                                                <% } %>
                                                <td style="color:var(--text-muted)">
                                                    <%= pr.avarageSePrice.toFixed(2) %> ₪
                                                </td>
                                                    <td>
                                                        <% if (pr.weightStatus==='متطابق' ) { %>
                                                            <span class="badge-status badge-success">
                                                                <%= pr.weightStatus %>
                                                            </span>
                                                            <% } %>
                                                                <% if (pr.weightStatus==='نقص' ) { %>
                                                                    <span class="badge-status badge-cancel">
                                                                        <%= pr.weightStatus %>
                                                                            <% if (pr.saleStatus==='closed' ) { %>
                                                                                - <%= pr.loseWeight %>
                                                                                    <% } %>
                                                                    </span>
                                                                    <% } %>
                                                                        <% if (pr.weightStatus==="لم يبع" ) { %>
                                                                            <span class="badge-status badge-tran">
                                                                                <%= pr.weightStatus %>
                                                                            </span>
                                                                            <% } %>
                                                    </td>

                                                    <td>
                                                        <% if (pr.saleStatus==='open' ) { %>
                                                            <% if (pr.stayStatus==='ontherDay' ) { %>
                                                                <span class="badge-status badge-success">
                                                                    مفتوح - آجل
                                                                </span>
                                                                <% } %>
                                                                    <% if (pr.stayStatus==='today' ) { %>
                                                                        <span class="badge-status badge-success">
                                                                            مفتوح
                                                                        </span>
                                                                        <% } %>
                                                                            <% } %>
                                                                                <% if (pr.saleStatus==='closed' ) { %>
                                                                                    <span
                                                                                        class="badge-status badge-cancel">
                                                                                        مغلق
                                                                                    </span>
                                                                                    <% } %>
                                                    </td>

                                                    <td>
                                                        <div class="action-btns">
                                                            <a href="/productDetailsPage/<%=  pr._id %>"
                                                                class="btn-icon" title="عرض تفاصيل الصنف">
                                                                <i class="fa-solid fa-eye"></i>
                                                            </a>
                                                            <a href="/editProductPage/<%= pr._id %>"
                                                                class="btn-icon btn-icon--assent"
                                                                title="تعديل معلومات الصنف">
                                                                <i class="fa-solid fa-pen"></i>
                                                            </a>

                                                            <form action="/deleteProduct/<%= pr._id %>" method="post"
                                                                class="d-inline"
                                                                onsubmit="return confirm('هل أنت متأكد من حذف هذا الصنف؟')">
                                                                <button class="btn-icon btn-icon--red">
                                                                    <i class="fa-solid fa-trash"></i>
                                                                </button>
                                                            </form>



                                                        </div>
                                                    </td>
                                </tr>
                                <% }) %>
                                    <% } %>


                                        <% if (products.length <=0 ) { %>
                                            <tr style="text-align: center;">
                                                <td colspan="9" style="color: #8e8c8c;">
                                                    لم يتم إضافة أي أصناف للفاتورة بعد.
                                                </td>
                                            </tr>
                                            <% } %>


                    </tbody>
                </table>
            </div>

            <div class="d-flex align-items-end mt-4">
                <div class="notes-box" style="width: 500px;">
                    <div class="notes-title">الملاحظات</div>
                    <div class="notes-content">
                        <%= invoice.notes %>
                    </div>
                </div>

                <div class="summary-box">
                    <% if (invoice.invoiceType==='كمسيون' ) { %>

                        <div class="sum-row">
                            <span>إجمالي المبيعات</span>
                            <span>
                                <%= totalSales.toFixed(2) %> ₪
                            </span>
                        </div>

                        <div class="sum-row">
                            <span>تكلفة نقل</span>
                            <span>
                                <%= invoice.transportCost.toFixed(2) %> ₪
                            </span>
                        </div>

                        <div class="sum-row">
                            <span>كمسيون <%= comRate %> %</span>
                            <span>
                                <%= totalCommission.toFixed(2) %> ₪
                            </span>
                        </div>

                        <div class="sum-row">
                            <span>المسحوبات <%= invoice.taken || '' %></span>
                            <span>
                                <%= Number(invoice.takenVal || 0).toFixed(2) %> ₪
                            </span>
                        </div>

                        <% } %>

                            <div class="sum-row total">
                                <span>إجمالي الفاتورة</span>
                                <span>
                                    <%= invoice.total.toFixed(2) %> ₪
                                </span>
                            </div>
                </div>
            </div>


            <!-- </div> -->
        </main>
        <script src="/Libraries/bootstrap/js/bootstrap.bundle.min.js"></script> <!-- bootstrap js min.js -->
        <script src="/js/main.js"></script>

        <script>
            const produRow = Array.from(document.querySelectorAll('.produ-row'));
            produRow.forEach(row => {
                row.addEventListener('dblclick', () => {
                    const href = row.getAttribute('data-href');
                    if (href) {
                        window.location.href = href;
                    }
                });
            });
            // document.querySelector('.btn-print').addEventListener('click', () => {
            //     window.print();
            // });
        </script>

</body>

</html>