

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= page %>
    </title>

    <!-- Google Fonts -->
    <link rel="stylesheet" href="/Libraries/fontawesome/css/all.min.css"> <!-- fontawesome css file -->
    <link rel="stylesheet" href="/Libraries/bootstrap/css/bootstrap.rtl.min.css"> <!-- bootstrap css min file -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/addProduct.css">



</head>



<body>
    <!-- sidebar -->
    <%- include('../../views/components/sidebar.ejs') %>

        <main class="main-content">
            <div class="form-card" style=" margin-top: 30px;">
                <div class="form-header">
                    <h3>إضافة مصروف جديد</h3>
                </div>

                <div id="formMessages" class="formMessages"></div>
                <form id="addDayexpense" action="/addExpenses">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">نوع المصروف<span class="req">*</span></label>
                            <select name="expType" id="" class="custom-input">
                                <option style="color: black;" value="">اختر نوع المصروف</option>
                                <option style="color: black;" value="مزليك">مزليك</option>
                                <option style="color: black;" value="تكاليف نقل">تكاليف نقل</option>
                                <option style="color: black;" value="سولار سيارة">سولار سيارة</option>
                                <option style="color: black;" value="سولار سيارة">صيانة سيارة</option>
                                <option style="color: black;" value="سولار سيارة">صيانة عامة</option>
                                <option style="color: black;" value="نايلون">نايلون</option>
                                <option style="color: black;" value="أكل">أكل</option>
                                <option style="color: black;" value="نقدي">نقدي</option>
                                <option style="color: black;" value="كهرباء">كهرباء</option>
                                <option style="color: black;" value="نت">نت</option>
                                <option style="color: black;" value="أخرى">أخرى</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">المبلغ<span class="req">*</span></label>
                            <input type="number" step="0.01" class="custom-input" name="amount"
                                placeholder="أدخل الوزن / العدد">
                        </div>


                        <div class="col-12">
                            <label class="form-label">تفاصيل المصروف</label>
                            <textarea rows="5" class="custom-input textarea" name="details"
                                placeholder="اكتب أي ملاحظات"></textarea>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="save-btn action-btn primary">
                                حفظ المصروف
                            </button>
                        </div>

                    </div>

                </form>
            </div>
        </main>




        <script src="/Libraries/bootstrap/js/bootstrap.bundle.min.js"></script> <!-- bootstrap js min.js -->
        <script src="/js/main.js"></script>

        <script>

            function showToast() {
                window.scrollTo({ left: 0, top: 0, behavior: `smooth` });
                const t = document.getElementById('formMessages');
                t.classList.add('show');
                setTimeout(() => t.classList.remove('show'), 3000);
            }
            const form = document.getElementById('addDayexpense');
            const messagesDiv = document.getElementById('formMessages');

            // إرسال الفورم عبر AJAX
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                messagesDiv.innerHTML = '';

                const fd = new FormData(form);
                const payload = {};
                fd.forEach((v, k) => payload[k] = v);

                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                        },
                        body: JSON.stringify(payload),
                    });

                    const data = await res.json();


                    if (!data.success) {
                        messagesDiv.innerHTML = data.msg;
                        showToast();
                        return;
                    }

                    window.location.href = data.redirect;

                } catch (err) {
                    console.error(err);
                    messagesDiv.innerHTML = `حصل خطأ في الخادم`;
                    showToast()
                }
            });
        </script>
</body>

</html>